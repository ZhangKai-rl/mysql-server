CREATE DATABASE IF NOT EXISTS test_unicode_case;
USE test_unicode_case;
#
# Save original parameters
#
SET @saved_collation_connection = @@collation_connection;
SET @saved_character_set_client = @@character_set_client;
SET @saved_character_set_results = @@character_set_results;
#
# CASE-1: Reproduce the original bug - String truncation with utf8mb4_0900_ai_ci
#
SET NAMES utf8mb4 COLLATE utf8mb4_0900_ai_ci;
SELECT lower('aaaȾbbb') AS result;
result
aaaⱦbbb
SELECT lower('aaaȾbbb') = 'aaaⱦbbb' AS is_correct;
is_correct
1
# End of CASE-1
#
# CASE-2: Test all known characters with byte-length-changing case conversion
#
SET NAMES utf8mb4 COLLATE utf8mb4_0900_ai_ci;
SELECT 'U+023F' AS unicode_point, 'Ȿ' AS original, lower('Ȿ') AS lowered,
HEX('Ȿ') AS hex_original, HEX(lower('Ȿ')) AS hex_lowered,
LENGTH('Ȿ') AS len_original, LENGTH(lower('Ȿ')) AS len_lowered;
unicode_point	original	lowered	hex_original	hex_lowered	len_original	len_lowered
U+023F	Ȿ	ȿ	E2B1BE	C8BF	3	2
SELECT 'U+2C7F->U+0240' AS conversion, 'ɀ' AS original, upper('ɀ') AS uppered,
HEX('ɀ') AS hex_original, HEX(upper('ɀ')) AS hex_uppered,
LENGTH('ɀ') AS len_original, LENGTH(upper('ɀ')) AS len_uppered;
conversion	original	uppered	hex_original	hex_uppered	len_original	len_uppered
U+2C7F->U+0240	ɀ		C980		2	0
SELECT upper('aaaɀbbb') AS result;
result
AAAⱿBBB
SELECT upper('aaaɀbbb') = 'aaaȺbbb' AS is_correct;
is_correct
0
SELECT upper('xxxⱦyyy') AS result;
result
XXXȾYYY
SELECT upper('pppȿqqq') AS result;
result
PPPⱾQQQ
SELECT upper('ⱦⱦⱦⱦ') AS multiple_reverse;
multiple_reverse
ȾȾȾȾ
SELECT upper('ⱦaȿbɀc') AS mixed_reverse;
mixed_reverse
ȾAⱾBⱿC
# End of CASE-2
#
# CASE-3: Edge cases - Empty, single char, multiple special chars
#
SET NAMES utf8mb4 COLLATE utf8mb4_0900_ai_ci;
SELECT lower('') AS empty_lower, upper('') AS empty_upper;
empty_lower	empty_upper
	
SELECT lower('Ⱦ') AS single_lower, upper('ⱦ') AS single_upper;
single_lower	single_upper
	Ⱦ
SELECT lower('ȾȾȾȾ') AS multiple_lower;
multiple_lower
ⱦⱦⱦⱦ
SELECT upper('ⱦⱦⱦⱦ') AS multiple_upper;
multiple_upper
ȾȾȾȾ
SELECT lower('ȾȾȾ') AS mixed_lower;
mixed_lower
ⱦⱦⱦ
SELECT lower('ȾȾȾ') AS mixed_lower2;
mixed_lower2
ⱦⱦⱦ
SELECT lower('Ⱦabc') AS at_start;
at_start
ⱦabc
SELECT lower('abcȾ') AS at_end;
at_end
abc
SELECT lower('aȾbȾc') AS in_middle;
in_middle
aⱦbⱦc
SELECT lower('ȾaȾbȾcȾ') AS multiple_positions;
multiple_positions
ⱦaⱦbⱦcⱦ
SELECT LENGTH(lower(CONCAT(REPEAT('a', 100), 'Ⱦ', REPEAT('b', 100)))) AS long_string_length;
long_string_length
203
SELECT SUBSTRING(lower(CONCAT(REPEAT('a', 100), 'Ⱦ', REPEAT('b', 100))), 98, 7) AS long_string_middle;
long_string_middle
aaaⱦbbb
SELECT lower('ȾȾ') AS only_special;
only_special
ⱦⱦ
SELECT upper('ⱦ') AS single_reverse_upper;
single_reverse_upper
Ⱦ
SELECT upper('ɀ') AS single_reverse_upper2;
single_reverse_upper2

SELECT upper('ⱦⱦⱦⱦ') AS multiple_reverse_upper;
multiple_reverse_upper
ȾȾȾȾ
SELECT upper('ɀɀɀɀ') AS multiple_reverse_upper2;
multiple_reverse_upper2
ⱿⱿⱿⱿ
SELECT upper('ⱦabc') AS reverse_at_start;
reverse_at_start
ȾABC
SELECT upper('abcⱦ') AS reverse_at_end;
reverse_at_end
ABCȾ
SELECT upper('aⱦbⱦc') AS reverse_in_middle;
reverse_in_middle
AȾBȾC
SELECT upper('ⱦaⱦbⱦcⱦ') AS reverse_multiple_positions;
reverse_multiple_positions
ȾAȾBȾCȾ
SELECT LENGTH(upper(CONCAT(REPEAT('a', 100), 'ⱦ', REPEAT('b', 100)))) AS long_reverse_length;
long_reverse_length
202
SELECT SUBSTRING(upper(CONCAT(REPEAT('a', 100), 'ⱦ', REPEAT('b', 100))), 98, 7) AS long_reverse_middle;
long_reverse_middle
AAAȾBBB
SELECT upper('ⱦⱦɀɀ') AS only_reverse_special;
only_reverse_special
ȾȾⱿⱿ
SELECT lower(upper('ⱦⱦⱦ')) AS reverse_roundtrip;
reverse_roundtrip
ⱦⱦⱦ
SELECT upper(lower('ȾȾȾ')) AS forward_roundtrip;
forward_roundtrip
ȾȾȾ
# End of CASE-3
#
# CASE-4: Compare behavior across different collations
#
SET NAMES utf8mb4 COLLATE utf8mb4_0900_ai_ci;
SELECT 'utf8mb4_0900_ai_ci' AS collation, lower('aaaȾbbb') AS result;
collation	result
utf8mb4_0900_ai_ci	aaaⱦbbb
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci;
SELECT 'utf8mb4_general_ci' AS collation, lower('aaaȾbbb') AS result;
collation	result
utf8mb4_general_ci	aaaȾbbb
SET NAMES utf8mb4 COLLATE utf8mb4_bin;
SELECT 'utf8mb4_bin' AS collation, lower('aaaȾbbb') AS result;
collation	result
utf8mb4_bin	aaaȾbbb
SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;
SELECT 'utf8mb4_unicode_ci' AS collation, lower('aaaȾbbb') AS result;
collation	result
utf8mb4_unicode_ci	aaaȾbbb
SET NAMES utf8mb4 COLLATE utf8mb4_0900_as_cs;
SELECT 'utf8mb4_0900_as_cs' AS collation, lower('aaaȾbbb') AS result;
collation	result
utf8mb4_0900_as_cs	aaaⱦbbb
# End of CASE-4
#
# CASE-5: Test with table columns and WHERE clauses
#
SET NAMES utf8mb4 COLLATE utf8mb4_0900_ai_ci;
CREATE TABLE test_case_conversion (
id INT NOT NULL AUTO_INCREMENT,
str_col VARCHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci,
text_col TEXT CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci,
PRIMARY KEY (id)
) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
INSERT INTO test_case_conversion(str_col, text_col) VALUES 
