SELECT id, str_col, lower(str_col) AS lowered, upper(str_col) AS uppered
FROM test_case_conversion;
SELECT * FROM test_view WHERE str_col LIKE '%Ⱦ%' ORDER BY id;
id	str_col	lowered	uppered
