# End of CASE-9
#
# CASE-11: Test with stored procedures and functions
#
SET NAMES utf8mb4 COLLATE utf8mb4_0900_ai_ci;
CREATE FUNCTION test_lower_func(input_str VARCHAR(255))
RETURNS VARCHAR(255)
DETERMINISTIC
BEGIN
RETURN lower(input_str);
END//
SELECT test_lower_func('aaaȾbbb') AS func_result;
func_result
aaaⱦbbb
SELECT test_lower_func('ȾȾȾȾ') AS func_result2;
func_result2
ⱦⱦⱦⱦ
CREATE PROCEDURE test_lower_proc(IN input_str VARCHAR(255), OUT output_str VARCHAR(255))
BEGIN
SET output_str = lower(input_str);
END//
CALL test_lower_proc('aaaȾbbb', @result);
SELECT @result AS proc_result;
proc_result
aaaⱦbbb
CALL test_lower_proc('ȾȾȾ', @result2);
SELECT @result2 AS proc_result2;
proc_result2
ⱦⱦⱦ
DROP FUNCTION test_lower_func;
DROP PROCEDURE test_lower_proc;
