SELECT 
'Forward' AS direction,
'Ⱦ' AS original,
lower('Ⱦ') AS converted,
LENGTH('Ⱦ') AS original_bytes,
LENGTH(lower('Ⱦ')) AS converted_bytes,
LENGTH(lower('Ⱦ')) - LENGTH('Ⱦ') AS byte_diff
UNION ALL
SELECT 
'Reverse' AS direction,
'ⱦ' AS original,
upper('ⱦ') AS converted,
LENGTH('ⱦ') AS original_bytes,
LENGTH(upper('ⱦ')) AS converted_bytes,
LENGTH(upper('ⱦ')) - LENGTH('ⱦ') AS byte_diff;
direction	original	converted	original_bytes	converted_bytes	byte_diff
Forward	Ⱦ		2	0	-2
Reverse	ⱦ	Ⱦ	3	2	-1
# End of CASE-7
#
# CASE-8: Test with larger datasets
#
SET NAMES utf8mb4 COLLATE utf8mb4_0900_ai_ci;
CREATE TABLE test_performance (
id INT AUTO_INCREMENT PRIMARY KEY,
data VARCHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci
);
INSERT INTO test_performance(data) 
SELECT CONCAT('test_', n, '_Ⱦ_', n) 
FROM (
SELECT 1 AS n UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5
UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10
) numbers;
SELECT COUNT(*) AS total_rows FROM test_performance;
total_rows
10
SELECT COUNT(*) AS correct_conversions 
FROM test_performance 
WHERE lower(data) LIKE '%ⱦ%';
correct_conversions
10
UPDATE test_performance SET data = lower(data) WHERE id <= 5;
SELECT id, data FROM test_performance WHERE id <= 5 ORDER BY id;
id	data
1	test_1_ⱦ_1
2	test_2_ⱦ_2
3	test_3_ⱦ_3
4	test_4_ⱦ_4
5	test_5_ⱦ_5
SELECT id, data FROM test_performance 
WHERE data IN (SELECT lower(str_col) FROM test_case_conversion WHERE str_col LIKE '%Ⱦ%')
ORDER BY id;
id	data
DROP TABLE test_performance;
