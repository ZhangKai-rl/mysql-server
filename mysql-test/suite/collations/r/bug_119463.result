#
# CASE-13: Regression test - Verify normal ASCII case conversion still works
#
SET NAMES utf8mb4 COLLATE utf8mb4_0900_ai_ci;
SELECT lower('HeLLo WoRLd') = 'hello world' AS mixed_ascii;
mixed_ascii
1
SELECT lower('ABC123XYZ!!!') = 'abc123xyz!!!' AS ascii_with_special;
ascii_with_special
1
SELECT lower('ÀÁÂÃÄÅÆÇÈÉÊË') AS european_chars;
european_chars
àáâãäåæçèéêë
# End of CASE-13
#
# Restore original parameters and clean up
#
SET collation_connection = @saved_collation_connection;
SET character_set_client = @saved_character_set_client;
SET character_set_results = @saved_character_set_results;
DROP TABLE IF EXISTS test_case_conversion;
DROP DATABASE IF EXISTS test_unicode_case;
#
# Bug#119463: Test completed successfully
# All case conversion operations with byte-length-changing characters work correctly
#
