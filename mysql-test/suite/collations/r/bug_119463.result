CREATE TABLE test_lookup (
lookup_str VARCHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci
);
INSERT INTO test_lookup VALUES ('aaaⱦbbb'), ('ⱦ'), ('normaltext');
SELECT t1.id, t1.str_col, t2.lookup_str 
FROM test_case_conversion t1 
INNER JOIN test_lookup t2 ON lower(t1.str_col) = t2.lookup_str
ORDER BY t1.id;
id	str_col	lookup_str
1	aaaȾbbb	aaaⱦbbb
2	Ⱦ	ⱦ
6	normaltext	normaltext
8	aaaⱦbbb	aaaⱦbbb
9	ⱦ	ⱦ
DROP TABLE test_lookup;
CREATE TABLE test_lookup_reverse (
lookup_str VARCHAR(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci
);
INSERT INTO test_lookup_reverse VALUES ('AAAȾBBB'), ('Ⱦ'), ('NORMALTEXT');
SELECT t1.id, t1.str_col, t2.lookup_str 
FROM test_case_conversion t1 
INNER JOIN test_lookup_reverse t2 ON upper(t1.str_col) = t2.lookup_str
ORDER BY t1.id;
