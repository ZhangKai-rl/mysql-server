('aaaⱦbbb', 'aaaⱦbbb'),
('ⱦ', 'ⱦ'),
('ⱦxxxⱦ', 'ⱦxxxⱦ'),
('ɀ', 'ɀ'),
('ⱦⱦⱦⱦ', 'ⱦⱦⱦⱦ'),
('Mixedⱦcase', 'Mixedⱦcase');
