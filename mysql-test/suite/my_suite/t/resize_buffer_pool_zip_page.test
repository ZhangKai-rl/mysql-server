#
# WL6117 : Resize the InnoDB Buffer Pool Online
#

--source include/have_innodb_max_16k.inc
--source include/big_test.inc

# open independent bp for user 'test@%'.
CREATE user 'test'@'%' IDENTIFIED WITH mysql_native_password BY 'passwd';
GRANT ALL PRIVILEGES ON *.* TO 'test'@'%' WITH GRANT OPTION;
FLUSH PRIVILEGES;
# --let $restart_parameters = restart: --innodb_txsql_independent_buffer_pool_users=test@%
# --source include/restart_mysqld.inc
# show variables like 'innodb_txsql_independent_buffer_pool_users';

# set condition that check if resize bp finished.
let $wait_timeout = 180;
let $wait_condition =
  SELECT SUBSTR(variable_value, 1, 34) = 'Completed resizing buffer pool at '
  FROM performance_schema.global_status
  WHERE LOWER(variable_name) = 'innodb_buffer_pool_resize_status';

--echo ##### zip table don't open phase1 opt and independent bp #####

connection default;

select @@innodb_buffer_pool_size;
# select @@innodb_ncdb_resize_buffer_pool_opt;
# show engine innodb status;

--echo ########################
--echo ## Increase BP to 16M ##
--echo ########################

# Expand buffer pool to 16M;
set global innodb_buffer_pool_size = 16777216;
--source include/wait_condition.inc
select @@innodb_buffer_pool_size;

# fill buffer pool
create table t1 (id int not null, val int not null default '0', primary key (id)) ENGINE=InnoDB ROW_FORMAT=COMPRESSED;
create or replace view view0 as select 1 union all select 1;
set @`v_id` := 0;
set @`v_val` := 0;
# 2^18 == 262144 records
replace into t1 select (@`v_id` := (@`v_id` + 1) mod 4294967296) as id, (@`v_val` := (@`v_val` + 1) mod 3) as val from view0 v0, view0 v1, view0 v2, view0 v3, view0 v4, view0 v5, view0 v6, view0 v7, view0 v8, view0 v9, view0 v10, view0 v11, view0 v12, view0 v13, view0 v14, view0 v15, view0 v16;
show engine innodb status;

connection test_con;
# fill clock and lru
select count(*) from t1 where val=1;
select * from t1;
select * from t1 limit 1000;
select * from t1 limit 1000;
show engine innodb status;
update t1 set val=55 WHERE val=1;
update t1 set val=55 WHERE val=2;

echo ##############  TEST 1 ############################################
echo ## connect to default to decrease bp while test_con doing update ##
echo ###################################################################

connection default;

--echo #########################
--echo ## Decrease BP to 8M ####
--echo #########################

# Shrink buffer pool to 8M
set global innodb_buffer_pool_size = 8388608;
--source include/wait_condition.inc

select @@innodb_buffer_pool_size;

select count(val) from t1;

--echo ##### zip table don't open phase1 opt but use independent bp #####
connect(test_con, localhost, test, passwd);
connection test_con;
show processlist;
# let $show_statement= SHOW DETAIL PROCESSLIST;
# let $field= Independent_buffer_pool_session;
# let $condition= = 'Yes';
# --source include/wait_show_condition.inc

connection default;

select @@innodb_buffer_pool_size;
# select @@innodb_ncdb_resize_buffer_pool_opt;
show engine innodb status;

--echo ########################
--echo ## Increase BP to 16M ##
--echo ########################

# Expand buffer pool to 16M;
set global innodb_buffer_pool_size = 16777216;
--source include/wait_condition.inc
select @@innodb_buffer_pool_size;

# fill buffer pool
create table t1 (id int not null, val int not null default '0', primary key (id)) ENGINE=InnoDB ROW_FORMAT=COMPRESSED;
create or replace view view0 as select 1 union all select 1;
set @`v_id` := 0;
set @`v_val` := 0;
# 2^18 == 262144 records
replace into t1 select (@`v_id` := (@`v_id` + 1) mod 4294967296) as id, (@`v_val` := (@`v_val` + 1) mod 3) as val from view0 v0, view0 v1, view0 v2, view0 v3, view0 v4, view0 v5, view0 v6, view0 v7, view0 v8, view0 v9, view0 v10, view0 v11, view0 v12, view0 v13, view0 v14, view0 v15, view0 v16;
show engine innodb status;

connection test_con;
# fill clock and lru
# select @@innodb_txsql_independent_buffer_pool_users;
select count(*) from t1 where val=1;
select * from t1;
select * from t1 limit 1000;
select * from t1 limit 1000;
show engine innodb status;
update t1 set val=55 WHERE val=1;
update t1 set val=55 WHERE val=2;

echo ## connect to default to decrease bp while test_con doing update ##
connection default;

--echo #########################
--echo ## Decrease BP to 64M ##
--echo #########################

# Shrink buffer pool to 8M
set global innodb_buffer_pool_size = 8388608;
--source include/wait_condition.inc

select @@innodb_buffer_pool_size;
show engine innodb status;

select count(val) from t1;

set global innodb_adaptive_hash_index=OFF;

# connection test_con;
# --reap;

connection default;
drop table t1;
drop view view0;

--disable_query_log
--enable_query_log
--source include/wait_condition.inc
