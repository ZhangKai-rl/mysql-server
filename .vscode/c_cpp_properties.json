{
    "configurations": [
        {
            "name": "MySQL Server",
            "compileCommands": "${workspaceFolder}/build_vscode_8039/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/build_vscode_8039/include",
                "${workspaceFolder}/include",
                "${workspaceFolder}/sql",
                "${workspaceFolder}/storage/innobase/include",
                "${workspaceFolder}/storage/innobase"
            ],
            "defines": [
                "HAVE_CONFIG_H",
                "MYSQL_SERVER"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64",
            // note: 配置好这个后， c/c++ 扩展的 lsp 就可以生效了
            "compileCommands": "${workspaceFolder}/build_vscode_8039/compile_commands.json",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}